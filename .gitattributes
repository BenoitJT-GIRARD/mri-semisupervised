# Line endings are normalised to LF in the repository, whatever the platform commits.
* text=auto eol=lf

*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Notebooks are JSON. They are text, but never merged by union: git would splice two
# versions into a file no reader can open, and report no conflict. They are also the
# laboratory notebook, not the code the project runs: GitHub's language statistics count
# them as documentation, so the bar measures the code.
*.ipynb text eol=lf linguist-documentation

# Binary: never converted on checkout, never diffed as text.
*.png binary
*.parquet binary
